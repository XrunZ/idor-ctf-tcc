# Salin file ini menjadi .env lalu sesuaikan.
# docker compose otomatis membaca .env (jangan commit .env ke git).

# Flag di-encode base64 SATU kali (flag asli -> base64).
# Aplikasi akan meng-encode sekali lagi untuk ditampilkan, jadi player decode 2x.
# Contoh dummy: TCC{local_dummy_flag_seccess}
#   -> echo -n 'TCC{local_dummy_flag_seccess}' | base64
FLAG_B64=VENDe2xvY2FsX2R1bW15X2ZsYWdfc2VjY2Vzc30=

# Kunci sesi Flask. Isi dengan string acak panjang untuk production.
# Kosongkan untuk memakai kunci acak per-boot (cukup untuk 1 worker).
SECRET_KEY=
